# Copy this file to .env and fill in the values you need.
# .env is gitignored — it is never committed.

# NVIDIA Inference API key, used by the NVIDIA GLM / Moonshot providers.
NVAPI_KEY=

# OpenAI API key, used as a fallback provider.
OPENAI_API_KEY=

# OpenRouter API key, used by the OpenRouter Moonshot provider.
OPENROUTER_API_KEY=
